{
  "$schema": "https://opencode.ai/config.json",
  "model": "amplify/gpt-5.2",
  "share": "disabled",
  "autoupdate": false,
  "enabled_providers": [
    "amplify"
  ],
  "disabled_providers": [
    "anthropic",
    "openai",
    "gemini",
    "github-copilot"
  ],
  "default_agent": "build",
  "provider": {
    "amplify": {
      "npm": "@ai-sdk/openai",
      "name": "Amplify OpenAI Proxy",
      "options": {
        "baseURL": "{env:AMPLIFY_URL}",
        "apiKey": "{env:AMPLIFY_TOKEN}"
      },
      "models": {
        "gpt-5.2": {
          "name": "Amplify-GPT-5.2-Quick",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "low"
          },
          "limit": {
            "context": 128000,
            "input": 128000,
            "output": 15000
          }
        },
        "gpt-5.4-opencode": {
          "name": "Amplify-GPT-5.4-Think",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "medium"
          },
          "limit": {
            "context": 128000,
            "input": 128000,
            "output": 15000
          }
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
